<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="420.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ProdutoViewController">
   <children>
      <TextArea fx:id="txtDescricaoProduto" layoutX="64.0" layoutY="218.0" prefHeight="124.0" prefWidth="475.0" />
      <Label layoutX="223.0" layoutY="189.0" text="Descrição do produto:">
         <font>
            <Font name="System Bold" size="15.0" />
         </font></Label>
      <Label layoutX="155.0" layoutY="33.0" text="Valor:">
         <font>
            <Font name="System Bold" size="14.0" />
         </font></Label>
      <TextField fx:id="txtfdValor" layoutX="78.0" layoutY="75.0" prefHeight="25.0" prefWidth="193.0" />
      <TextField fx:id="txtfdQuantidadeEstoque" layoutX="335.0" layoutY="75.0" prefHeight="25.0" prefWidth="193.0" />
      <Label layoutX="351.0" layoutY="33.0" text="Quantidade em estoque:">
         <font>
            <Font name="System Bold" size="14.0" />
         </font></Label>
      <Button fx:id="btnCadastrarProduto" layoutX="231.0" layoutY="360.0" mnemonicParsing="false" onAction="#OnActionCadastrarProdutos" text="Cadastrar produto">
         <font>
            <Font name="System Bold" size="14.0" />
         </font></Button>
   </children>
</AnchorPane>
